# AI Service Environment Configuration Template
PORT=8000
HOST=0.0.0.0
ENV=development

# Abstraction Provider Settings
LLM_PROVIDER=mock # mock | openai | anthropic | azure
LLM_API_KEY=
EMBEDDING_PROVIDER=mock # mock | openai | huggingface
EMBEDDING_MODEL=text-embedding-3-small
OCR_ENGINE=tesseract # tesseract | easyocr | fitz

STORAGE_DIR=../../storage
DATA_DIR=../../data
