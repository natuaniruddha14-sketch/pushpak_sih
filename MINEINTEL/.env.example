# ==============================================================================
# MINEINTEL AI PLATFORM - ENVIRONMENT CONFIGURATION (HYBRID SUPABASE ARCHITECTURE)
# ==============================================================================

PORT=4000
NODE_ENV=development
HOST=0.0.0.0
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 1. SUPABASE POSTGRESQL + PGVECTOR DATABASE
# ------------------------------------------------------------------------------
# In Supabase Project Settings -> Database:
# Use Transaction Mode (Port 6543) for DATABASE_URL with PgBouncer
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Use Session Mode / Direct Connection (Port 5432) for DIRECT_URL (Prisma migrations)
DIRECT_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Local PostgreSQL Fallback (if Supabase is not yet configured):
# DATABASE_URL="postgresql://mineintel_user:mineintel_password@localhost:5432/mineintel_db?schema=public"

# ------------------------------------------------------------------------------
# 2. SUPABASE STORAGE (S3-Compatible Cloud Storage for Mining Documents)
# ------------------------------------------------------------------------------
# Provider: 'supabase' for cloud bucket, or 'local' for local disk ./storage/uploads
STORAGE_PROVIDER=supabase

# From Supabase Project Settings -> API:
SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_STORAGE_BUCKET="mineintel-documents"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET=mineintel-dev-jwt-secret-key-change-in-production-32chars!
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# 4. PYTHON AI MICROSERVICE & RAG
# ------------------------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
