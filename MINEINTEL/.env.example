# Root MINEINTEL AI Environment Configuration Template

# Node Environment
NODE_ENV=development

# PostgreSQL + pgvector Configuration
POSTGRES_USER=mineintel_user
POSTGRES_PASSWORD=mineintel_password
POSTGRES_DB=mineintel_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
DATABASE_URL=postgresql://mineintel_user:mineintel_password@localhost:5432/mineintel_db?schema=public

# API Service Configuration
API_PORT=4000
API_HOST=localhost
JWT_SECRET=mineintel-dev-jwt-secret-key-change-in-production-32chars!
AI_SERVICE_URL=http://localhost:8000

# AI Service Configuration
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0
LLM_PROVIDER=openai # openai | anthropic | azure | mock
LLM_API_KEY=
EMBEDDING_PROVIDER=openai # openai | huggingface | mock
EMBEDDING_MODEL=text-embedding-3-small
OCR_ENGINE=tesseract # tesseract | easyocr | fitz

# Web Frontend Configuration
VITE_API_URL=http://localhost:4000
VITE_AI_SERVICE_URL=http://localhost:8000
