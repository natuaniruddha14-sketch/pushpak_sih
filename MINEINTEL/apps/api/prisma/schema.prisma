// Prisma Schema for MINEINTEL AI Platform
// Database: PostgreSQL with pgvector extension

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector")]
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserRole {
  ADMIN
  ANALYST
  GEOLOGIST
  MINING_ENGINEER
  EXECUTIVE
  VIEWER
}

enum DocumentType {
  PDF
  SCANNED_PDF
  DOCX
  EXCEL
  IMAGE
}

enum ProcessingStage {
  UPLOADED
  PROCESSING
  OCR_REQUIRED
  EXTRACTING
  INDEXING
  COMPLETED
  PARTIAL
  FAILED
  // Legacy aliases
  OCR_EXTRACTING
  METADATA_EXTRACTING
  STRUCTURED_DATA_EXTRACTING
  CHUNKING
  EMBEDDING
  INDEXED
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ReportTemplate {
  EXECUTIVE_SUMMARY
  GEOLOGICAL_RESERVE
  PRODUCTION_AUDIT
}

enum ReportFormat {
  PDF
  DOCX
}

// -----------------------------------------------------------------------------
// Models
// -----------------------------------------------------------------------------

model Organization {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique // e.g. "CMPDI-HQ", "CIL-WCL"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users     User[]
  projects  Project[]
  auditLogs AuditLog[]

  @@index([code])
}

model User {
  id             String   @id @default(uuid())
  organizationId String
  email          String   @unique
  name           String
  passwordHash   String
  role           UserRole @default(GEOLOGIST)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects       Project[]       @relation("ProjectOwner")
  uploadedDocs   Document[]      @relation("DocumentUploader")
  processingJobs ProcessingJob[]
  querySessions  QuerySession[]
  reports        Report[]        @relation("ReportAuthor")
  auditLogs      AuditLog[]

  @@index([organizationId])
  @@index([email])
}

model Project {
  id             String   @id @default(uuid())
  organizationId String
  ownerId        String
  name           String
  code           String   @unique // e.g. "PRJ-RAJMAHAL-2026"
  description    String?
  mineLocation   String? // e.g. "Singrauli Coalfield, MP"
  targetSeam     String? // e.g. "Turra / Purewa Seam"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User               @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  documents      Document[]
  structuredRecs StructuredRecord[]
  processingJobs ProcessingJob[]
  querySessions  QuerySession[]
  reports        Report[]

  @@index([organizationId])
  @@index([ownerId])
  @@index([code])
}

model Document {
  id              String          @id @default(uuid())
  projectId       String
  uploaderId      String
  title           String
  filename        String
  fileType        DocumentType
  fileSizeBytes   Int
  mimeType        String
  checksum        String          @unique // SHA-256 unique file hash
  storagePath     String
  processingStage ProcessingStage @default(UPLOADED)
  pageCount       Int?
  chunkCount      Int?
  errorMessage    String?
  mineName        String? // e.g. "Gevra OpenCast Project"
  blockName       String? // e.g. "Block-B West"
  coalSeam        String? // e.g. "Seam V/VI/VII"
  reserveCategory String? // Proved, Indicated, Inferred
  authoringBody    String? // CMPDI Regional Institute-1
  reportYear       Int?
  sourceDepartment String? // e.g. "Geology & Exploration Dept"
  subsidiary       String? // e.g. "SECL", "ECL", "CMPDI"
  documentDate     DateTime?
  processingError  String?
  ocrConfidence    Float?
  ocrStatus        String? // "NATIVE", "OCR_PROCESSED", "LOW_CONFIDENCE"
  tables           Json? // Structured extracted tables
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader       User               @relation("DocumentUploader", fields: [uploaderId], references: [id], onDelete: Restrict)
  pages          DocumentPage[]
  chunks         DocumentChunk[]
  entities       DocumentEntity[]
  structuredRecs StructuredRecord[]
  processingJobs ProcessingJob[]
  reportSources  ReportSource[]
  citations      Citation[]

  @@index([projectId])
  @@index([uploaderId])
  @@index([checksum])
  @@index([fileType])
  @@index([processingStage])
}

model DocumentPage {
  id         String   @id @default(uuid())
  documentId String
  pageNumber Int
  rawText    String   @db.Text
  imagePath  String?
  hasTables  Boolean  @default(false)
  hasImages  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  document  Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunks    DocumentChunk[]
  entities  DocumentEntity[]
  citations Citation[]

  @@unique([documentId, pageNumber])
  @@index([documentId])
}

model DocumentChunk {
  id         String                 @id @default(uuid())
  documentId String
  pageId     String?
  chunkIndex Int
  content    String                 @db.Text
  tokenCount Int
  startChar  Int?
  endChar    Int?
  embedding  Unsupported("vector(1536)")? // Vector embedding (pgvector 1536 dimensions)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  document  Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  page      DocumentPage? @relation(fields: [pageId], references: [id], onDelete: SetNull)
  citations Citation[]

  @@index([documentId])
  @@index([pageId])
}

model DocumentEntity {
  id          String   @id @default(uuid())
  documentId  String
  pageId      String?
  entityType  String // e.g., "COAL_SEAM", "BOREHOLE_ID", "RESERVE_METRIC", "MINE_BLOCK"
  entityValue String
  confidence  Float    @default(1.0)
  metadata    Json?
  createdAt   DateTime @default(now())

  document Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  page     DocumentPage? @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([entityType])
}

model StructuredRecord {
  id                      String   @id @default(uuid())
  projectId               String
  documentId              String
  mineName                String
  blockName               String?
  coalSeam                String?
  // Numeric mining metrics
  provedReserveMt         Float? // Proved coal reserves in Million Tonnes
  indicatedReserveMt      Float? // Indicated reserves in MT
  inferredReserveMt       Float? // Inferred reserves in MT
  seamThicknessMeters     Float? // Seam thickness in meters
  ashContentPercent       Float? // Ash content percentage
  moisturePercent         Float? // Moisture percentage
  volatileMatterPercent   Float? // Volatile matter percentage
  grossCalorificValueKcal Float? // Gross Calorific Value (GCV in kcal/kg)
  strippingRatio          Float? // Overburden stripping ratio (m3/tonne)
  annualProductionMt      Float? // Annual production capacity in MT
  depthMeters             Float? // Seam depth in meters
  extractedData           Json? // Full key-value dictionary of raw table metrics
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([documentId])
  @@index([mineName])
  @@index([coalSeam])
}

model ProcessingJob {
  id              String    @id @default(uuid())
  projectId       String
  documentId      String
  userId          String
  status          JobStatus @default(QUEUED)
  progressPercent Int       @default(0) // Progress tracking (0 - 100)
  currentStep     String? // e.g. "OCR Extraction", "Chunking", "Generating Vector Embeddings"
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([documentId])
  @@index([status])
}

model QuerySession {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  title     String // e.g. "Rajmahal Coal Seam Thickness Analysis"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages QueryMessage[]

  @@index([projectId])
  @@index([userId])
}

model QueryMessage {
  id         String      @id @default(uuid())
  sessionId  String
  role       MessageRole
  content    String      @db.Text
  tokenCount Int?
  latencyMs  Int?
  createdAt  DateTime    @default(now())

  session   QuerySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  citations Citation[]

  @@index([sessionId])
}

model Citation {
  id             String   @id @default(uuid())
  messageId      String
  documentId     String
  pageId         String?
  chunkId        String?
  documentTitle  String
  pageNumber     Int?
  snippet        String   @db.Text
  relevanceScore Float
  createdAt      DateTime @default(now())

  message  QueryMessage   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  document Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  page     DocumentPage?  @relation(fields: [pageId], references: [id], onDelete: SetNull)
  chunk    DocumentChunk? @relation(fields: [chunkId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([documentId])
}

model Report {
  id           String         @id @default(uuid())
  projectId    String
  authorId     String
  title        String
  templateType ReportTemplate
  status       JobStatus      @default(QUEUED)
  summaryText  String?        @db.Text
  storagePath  String?
  fileFormat   ReportFormat   @default(PDF)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User           @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  sources ReportSource[]

  @@index([projectId])
  @@index([authorId])
}

model ReportSource {
  id         String   @id @default(uuid())
  reportId   String
  documentId String
  createdAt  DateTime @default(now())

  report   Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([reportId, documentId])
  @@index([reportId])
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  userId         String?
  action         String // e.g., "DOCUMENT_UPLOAD", "QUERY_RUN", "REPORT_GENERATED"
  entityType     String // e.g., "Document", "QuerySession", "Report"
  entityId       String?
  details        Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([action])
}
